# Copy to .env and adjust. docker-compose reads ANTHROPIC_API_KEY / SCORING_MODEL
# from your shell environment or a .env file placed next to docker-compose.yml.

# --- LLM Scoring Service (Section 3.3 / Section 6) ---------------------------
# Leave BLANK to run the deterministic mock scorer (no credentials needed).
# Set a real key to enable live Claude scoring.
ANTHROPIC_API_KEY=
# Haiku 4.5 is the cost-driven default for high-volume screening (Section 3.3).
SCORING_MODEL=claude-haiku-4-5
SCORING_PROMPT_VERSION=kuza-scoring-v1

# --- Database (compose sets this for the api service automatically) ----------
# For running the backend outside docker:
DATABASE_URL=postgresql+psycopg://kuza:kuza@localhost:5432/kuza

# --- Dashboard chatbot --------------------------------------------------------
# Reuses ANTHROPIC_API_KEY above. Override the model independently if needed.
CHATBOT_MODEL=claude-haiku-4-5

# --- WhatsApp / SMS / USSD providers (Section 6) ------------------------------
# "mock" needs no credentials and is what runs if you leave these as-is.
WHATSAPP_PROVIDER=mock
SMS_PROVIDER=mock
USSD_PROVIDER=mock

# The exact public HTTPS URL this API is reachable at, no trailing slash.
# Required to verify Twilio's webhook signature once WHATSAPP_PROVIDER or
# SMS_PROVIDER is set to "twilio".
PUBLIC_BASE_URL=

# Twilio (set WHATSAPP_PROVIDER=twilio and/or SMS_PROVIDER=twilio to use these).
# Account SID + Auth Token: console.twilio.com.
# TWILIO_WHATSAPP_FROM is a WhatsApp-enabled Twilio number, "whatsapp:+1415...",
# e.g. the Twilio Sandbox number while testing. TWILIO_SMS_FROM is a plain
# Twilio phone number, "+1415...".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Africa's Talking (set USSD_PROVIDER=africastalking to use these).
# Username + API key from africastalking.com, plus a leased USSD shortcode
# configured against the /screening/webhook/ussd callback in their dashboard.
# They do not sign webhooks, so USSD_WEBHOOK_SECRET is a shared secret WE
# choose and append to that callback URL ourselves: ".../webhook/ussd?key=...".
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
USSD_WEBHOOK_SECRET=
