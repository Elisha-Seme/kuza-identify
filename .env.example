# Copy to .env and adjust. docker-compose reads ANTHROPIC_API_KEY / SCORING_MODEL
# from your shell environment or a .env file placed next to docker-compose.yml.

# --- LLM Scoring Service (Section 3.3 / Section 6) ---------------------------
# Leave BLANK to run the deterministic mock scorer (no credentials needed).
# Set a real key to enable live Claude scoring.
ANTHROPIC_API_KEY=
# Haiku 4.5 is the cost-driven default for high-volume screening (Section 3.3).
SCORING_MODEL=claude-haiku-4-5
SCORING_PROMPT_VERSION=kuza-scoring-v1

# --- Database (compose sets this for the api service automatically) ----------
# For running the backend outside docker:
DATABASE_URL=postgresql+psycopg://kuza:kuza@localhost:5432/kuza

# --- WhatsApp provider (Section 6) -------------------------------------------
# Only "mock" is wired for Phase 0. No Africa's Talking / Twilio credentials yet.
WHATSAPP_PROVIDER=mock
